{
  "ConnectionStrings": {
    "BotDb": "Data Source=bot-service.db"
  },
  "BotService": {
    "Enabled": true,
    "Keycloak": {
      "BaseUrl": "http://localhost:8090"
    },
    "Endpoints": {
      "UserService": "http://localhost:8082",
      "MatchmakingService": "http://localhost:8083",
      "PhotoService": "http://localhost:8085",
      "MessagingService": "http://localhost:8086",
      "SwipeService": "http://localhost:8087",
      "SafetyService": "http://localhost:8088",
      "Gateway": "http://localhost:8080",
      "MessagingHub": "http://localhost:8086/hubs/messages"
    },
    "Whisper": {
      "Enabled": false,
      "BaseUrl": "http://localhost:8095",
      "IntervalSeconds": 30,
      "BatchSize": 5,
      "TimeoutSeconds": 300,
      "Language": "auto"
    },
    "Modes": {
      "Synthetic": { "Enabled": true },
      "Warmup": { "Enabled": true },
      "Load": { "Enabled": false },
      "Chaos": { "Enabled": false }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  }
}

{
  "ConnectionStrings": {
    "BotDb": "Data Source=bot-service.db"
  },
  "BotService": {
    "Enabled": true,
    "Keycloak": {
      "BaseUrl": "http://localhost:8090"
    },
    "Endpoints": {
      "UserService": "http://localhost:8080",
      "MatchmakingService": "http://localhost:8080",
      "PhotoService": "http://localhost:8080",
      "MessagingService": "http://localhost:8080",
      "SwipeService": "http://localhost:8080",
      "SafetyService": "http://localhost:8080",
      "MessagingHub": "http://localhost:8080/hubs/messages"
    },
    "Modes": {
      "Synthetic": { "Enabled": true },
      "Warmup": { "Enabled": true },
      "Load": { "Enabled": false },
      "Chaos": { "Enabled": false }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  }
}
